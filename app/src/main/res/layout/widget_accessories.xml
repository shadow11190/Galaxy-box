<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="match_parent" android:layout_height="68dp" android:layout_gravity="center_vertical">
        <ImageView android:id="@+id/widget_background_layer" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
            <LinearLayout android:id="@+id/widget_battery_slots" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" />
            <TextView android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="48dp"
                android:text="@string/widget_refresh_symbol" android:textSize="20sp" android:gravity="center"
                android:contentDescription="@string/widget_refresh_description" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
